                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (select * from [dbo].[dim_cliente]) [refTable]
where [refTable].[codigo_cliente] = ? and [refTable].[nombre_cliente] = ? and [refTable].[tipo_cliente] = ? and [refTable].[direccion_cliente] = ? and [refTable].[numero_cliente] = ?</property>
